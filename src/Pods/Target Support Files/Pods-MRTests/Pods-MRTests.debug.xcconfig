CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(PLATFORM_DIR)/Developer/Library/Frameworks" "${PODS_ROOT}/HockeySDK-Source/Vendor"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/ARAnalytics" "${PODS_ROOT}/Headers/Public/BlocksKit" "${PODS_ROOT}/Headers/Public/CocoaAsyncSocket" "${PODS_ROOT}/Headers/Public/DAKeyboardControl" "${PODS_ROOT}/Headers/Public/Expecta" "${PODS_ROOT}/Headers/Public/FXForms" "${PODS_ROOT}/Headers/Public/HockeySDK-Source" "${PODS_ROOT}/Headers/Public/IFTTTLaunchImage" "${PODS_ROOT}/Headers/Public/JASidePanels" "${PODS_ROOT}/Headers/Public/JSQSystemSoundPlayer" "${PODS_ROOT}/Headers/Public/JTSImageViewController" "${PODS_ROOT}/Headers/Public/KVOController" "${PODS_ROOT}/Headers/Public/Keys" "${PODS_ROOT}/Headers/Public/MagicalRecord" "${PODS_ROOT}/Headers/Public/Masonry" "${PODS_ROOT}/Headers/Public/MyLilTimer" "${PODS_ROOT}/Headers/Public/OCMock" "${PODS_ROOT}/Headers/Public/OSCache" "${PODS_ROOT}/Headers/Public/QuickDialog" "${PODS_ROOT}/Headers/Public/SAMRateLimit" "${PODS_ROOT}/Headers/Public/SPLCore" "${PODS_ROOT}/Headers/Public/SPLUserActivity" "${PODS_ROOT}/Headers/Public/SSAccessibility" "${PODS_ROOT}/Headers/Public/SSApplication" "${PODS_ROOT}/Headers/Public/SSDataSources" "${PODS_ROOT}/Headers/Public/SSOperations" "${PODS_ROOT}/Headers/Public/TOWebViewController" "${PODS_ROOT}/Headers/Public/TTTAttributedLabel" "${PODS_ROOT}/Headers/Public/VTAcknowledgementsViewController" "${PODS_ROOT}/Headers/Public/libextobjc" "${PODS_ROOT}/Headers/Public/libtelnet" "${PODS_ROOT}/Headers/Public/uservoice-iphone-sdk"
LIBRARY_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/ARAnalytics" "${PODS_CONFIGURATION_BUILD_DIR}/BlocksKit" "${PODS_CONFIGURATION_BUILD_DIR}/CocoaAsyncSocket" "${PODS_CONFIGURATION_BUILD_DIR}/DAKeyboardControl" "${PODS_CONFIGURATION_BUILD_DIR}/Expecta" "${PODS_CONFIGURATION_BUILD_DIR}/FXForms" "${PODS_CONFIGURATION_BUILD_DIR}/HockeySDK-Source" "${PODS_CONFIGURATION_BUILD_DIR}/IFTTTLaunchImage" "${PODS_CONFIGURATION_BUILD_DIR}/JASidePanels" "${PODS_CONFIGURATION_BUILD_DIR}/JSQSystemSoundPlayer" "${PODS_CONFIGURATION_BUILD_DIR}/JTSImageViewController" "${PODS_CONFIGURATION_BUILD_DIR}/KVOController" "${PODS_CONFIGURATION_BUILD_DIR}/Keys" "${PODS_CONFIGURATION_BUILD_DIR}/MagicalRecord" "${PODS_CONFIGURATION_BUILD_DIR}/Masonry" "${PODS_CONFIGURATION_BUILD_DIR}/MyLilTimer" "${PODS_CONFIGURATION_BUILD_DIR}/OCMock" "${PODS_CONFIGURATION_BUILD_DIR}/OSCache" "${PODS_CONFIGURATION_BUILD_DIR}/QuickDialog" "${PODS_CONFIGURATION_BUILD_DIR}/SAMRateLimit" "${PODS_CONFIGURATION_BUILD_DIR}/SPLCore" "${PODS_CONFIGURATION_BUILD_DIR}/SPLUserActivity" "${PODS_CONFIGURATION_BUILD_DIR}/SSAccessibility" "${PODS_CONFIGURATION_BUILD_DIR}/SSApplication" "${PODS_CONFIGURATION_BUILD_DIR}/SSDataSources" "${PODS_CONFIGURATION_BUILD_DIR}/SSOperations" "${PODS_CONFIGURATION_BUILD_DIR}/TOWebViewController" "${PODS_CONFIGURATION_BUILD_DIR}/TTTAttributedLabel" "${PODS_CONFIGURATION_BUILD_DIR}/VTAcknowledgementsViewController" "${PODS_CONFIGURATION_BUILD_DIR}/libextobjc" "${PODS_CONFIGURATION_BUILD_DIR}/libtelnet" "${PODS_CONFIGURATION_BUILD_DIR}/uservoice-iphone-sdk"
OTHER_LDFLAGS = $(inherited) -ObjC -l"ARAnalytics" -l"BlocksKit" -l"CocoaAsyncSocket" -l"DAKeyboardControl" -l"Expecta" -l"FXForms" -l"HockeySDK-Source" -l"IFTTTLaunchImage" -l"JASidePanels" -l"JSQSystemSoundPlayer" -l"JTSImageViewController" -l"KVOController" -l"Keys" -l"MagicalRecord" -l"Masonry" -l"MyLilTimer" -l"OCMock" -l"OSCache" -l"QuickDialog" -l"SAMRateLimit" -l"SPLCore" -l"SPLUserActivity" -l"SSAccessibility" -l"SSApplication" -l"SSDataSources" -l"SSOperations" -l"TOWebViewController" -l"TTTAttributedLabel" -l"VTAcknowledgementsViewController" -l"c++" -l"libextobjc" -l"libtelnet" -l"uservoice-iphone-sdk" -l"z" -framework "Accelerate" -framework "AudioToolbox" -framework "CFNetwork" -framework "CoreData" -framework "CoreGraphics" -framework "CoreTelephony" -framework "CoreText" -framework "CrashReporter" -framework "Foundation" -framework "ImageIO" -framework "MessageUI" -framework "MobileCoreServices" -framework "Photos" -framework "QuartzCore" -framework "QuickLook" -framework "Security" -framework "SystemConfiguration" -framework "UIKit" -framework "WebKit" -framework "XCTest"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
